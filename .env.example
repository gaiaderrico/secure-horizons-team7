# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=
MIRAGE_LLM=ollama            # ollama | anthropic
OLLAMA_MODEL=qwen2.5:7b

# Victim SSH password for svc_backup and jdupont (choose your own, synthetic)
VICTIM_PASSWORD=
# Required. Shared secret for the guard control API (http://victim:8081/contain, /restore, /swap,
# /status). docker-compose passes this same value to the guard and to core; core sends it in the
# X-Guard-Token header, requests without it get 401. Generate one: openssl rand -hex 16
GUARD_TOKEN=
